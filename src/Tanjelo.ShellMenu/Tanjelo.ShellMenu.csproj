<Project Sdk="Microsoft.NET.Sdk">

  <!-- The entry in the Windows 11 right-click menu: a small COM server that Explorer loads (through a surrogate, so a
       crash here can't take Explorer down) from the sparse package in Package\. Published with NativeAOT, it's a plain
       native DLL with no .NET to load, so the menu draws at once. NativeAOT needs the C++ build tools, which the release
       workflow's runner has; a normal build only checks it compiles. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>TanjeloMenu</AssemblyName>
    <RootNamespace>Tanjelo.ShellMenu</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyTitle>Tanjelo's Windows 11 menu entry</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tanjelo.Core.Tests" />
  </ItemGroup>

</Project>
