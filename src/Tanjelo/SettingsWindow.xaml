<Window x:Class="Tanjelo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tanjelo"
        Title="Tanjelo settings" Width="600" Height="740" MinWidth="520" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,18,0,10" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        </Style>
        <Style x:Key="Problem" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Width" Value="64" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style x:Key="ToolStatus" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Drag here to move the window -->
        <Grid Height="56" Margin="18,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="32" Height="32" Margin="0,0,12,0">
                <Ellipse Fill="{DynamicResource AccentSoft}" />
                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="14" />
                <TextBlock x:Name="Subheading" FontSize="12" Margin="0,1,0,0" Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis" Text="Changes apply at once" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Padding="10"
                    VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close (Esc)"
                    AutomationProperties.Name="Close" Focusable="True" IsTabStop="False" />
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,6,0">
            <StackPanel Margin="18,0,18,8" KeyboardNavigation.TabNavigation="Continue">

                <TextBlock Text="Shortcuts" Style="{StaticResource SectionHeading}" Margin="0,4,0,10" />
                <TextBlock x:Name="MenuShortcutLabel" Text="Open the menu" Style="{StaticResource Label}" />
                <local:ShortcutBox x:Name="MenuShortcut" Style="{StaticResource FieldBox}" Width="220" HorizontalAlignment="Left"
                                   AutomationProperties.LabeledBy="{Binding ElementName=MenuShortcutLabel}"
                                   AutomationProperties.HelpText="Click here and press the keys for the new shortcut" />
                <TextBlock x:Name="MenuShortcutHint" Style="{StaticResource Hint}"
                           Text="Works while File Explorer, the desktop or the shelf is in front. Click the box and press new keys to change it." />

                <TextBlock x:Name="ShelfShortcutLabel" Text="Show or hide the shelf" Style="{StaticResource Label}" Margin="0,14,0,6" />
                <StackPanel Orientation="Horizontal">
                    <local:ShortcutBox x:Name="ShelfShortcut" Style="{StaticResource FieldBox}" Width="220" Optional="True" Tag="None"
                                       AutomationProperties.LabeledBy="{Binding ElementName=ShelfShortcutLabel}"
                                       AutomationProperties.HelpText="Click here and press the keys for the new shortcut; Backspace removes it" />
                    <Button x:Name="ClearShelfShortcut" Style="{StaticResource SubtleButton}" Content="Remove" Margin="8,0,0,0" Focusable="True"
                            AutomationProperties.Name="Remove the shelf shortcut" />
                </StackPanel>
                <TextBlock x:Name="ShelfShortcutHint" Style="{StaticResource Hint}" Text="Works everywhere. Off unless you set one." />
                <TextBlock x:Name="ShortcutProblem" Style="{StaticResource Problem}" Visibility="Collapsed" />

                <TextBlock Text="Appearance" Style="{StaticResource SectionHeading}" />
                <TextBlock x:Name="ThemeLabel" Text="Theme" Style="{StaticResource Label}" />
                <WrapPanel x:Name="ThemeChoices" AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}">
                    <RadioButton x:Name="ThemeSystem" Style="{StaticResource Chip}" GroupName="Theme" Content="Same as Windows" />
                    <RadioButton x:Name="ThemeLight" Style="{StaticResource Chip}" GroupName="Theme" Content="Light" />
                    <RadioButton x:Name="ThemeDark" Style="{StaticResource Chip}" GroupName="Theme" Content="Dark" />
                </WrapPanel>

                <TextBlock Text="Quality" Style="{StaticResource SectionHeading}" />
                <TextBlock x:Name="JpegLabel" Text="JPG quality" Style="{StaticResource Label}" />
                <DockPanel>
                    <TextBlock x:Name="JpegValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}" />
                    <Slider x:Name="JpegSlider" Style="{StaticResource ThinSlider}" Minimum="1" Maximum="100" SmallChange="1" LargeChange="10"
                            IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.LabeledBy="{Binding ElementName=JpegLabel}" />
                </DockPanel>
                <TextBlock x:Name="WebpLabel" Text="WebP quality" Style="{StaticResource Label}" Margin="0,12,0,6" />
                <DockPanel>
                    <TextBlock x:Name="WebpValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}" />
                    <Slider x:Name="WebpSlider" Style="{StaticResource ThinSlider}" Minimum="1" Maximum="100" SmallChange="1" LargeChange="10"
                            IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.LabeledBy="{Binding ElementName=WebpLabel}" />
                </DockPanel>
                <TextBlock x:Name="HeicLabel" Text="HEIC quality" Style="{StaticResource Label}" Margin="0,12,0,6" />
                <DockPanel>
                    <TextBlock x:Name="HeicValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}" />
                    <Slider x:Name="HeicSlider" Style="{StaticResource ThinSlider}" Minimum="1" Maximum="100" SmallChange="1" LargeChange="10"
                            IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.LabeledBy="{Binding ElementName=HeicLabel}" />
                </DockPanel>
                <TextBlock x:Name="DpiLabel" Text="PDF pages as pictures" Style="{StaticResource Label}" Margin="0,12,0,6" />
                <DockPanel>
                    <TextBlock x:Name="DpiValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}" />
                    <Slider x:Name="DpiSlider" Style="{StaticResource ThinSlider}" Minimum="72" Maximum="600" SmallChange="1" LargeChange="50"
                            IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.LabeledBy="{Binding ElementName=DpiLabel}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="Higher numbers look better and make bigger files. Tools with their own settings, such as Compress, choose for themselves." />

                <TextBlock Text="Optional programs" Style="{StaticResource SectionHeading}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,-4,0,10"
                           Text="Installed separately and found automatically. Formats that need a missing one stay out of the menu." />
                <TextBlock x:Name="FfmpegLabel" Text="ffmpeg, for audio and video" Style="{StaticResource Label}" />
                <DockPanel>
                    <Button x:Name="FfmpegBrowse" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="Browse…" Margin="8,0,0,0"
                            Focusable="True" AutomationProperties.Name="Choose ffmpeg.exe" />
                    <TextBox x:Name="FfmpegPath" Style="{StaticResource FieldBox}" Tag="Found automatically"
                             AutomationProperties.LabeledBy="{Binding ElementName=FfmpegLabel}" />
                </DockPanel>
                <TextBlock x:Name="FfmpegStatus" Style="{StaticResource Hint}" />

                <TextBlock x:Name="SevenZipLabel" Text="7-Zip, for 7Z and RAR archives" Style="{StaticResource Label}" Margin="0,14,0,6" />
                <DockPanel>
                    <Button x:Name="SevenZipBrowse" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="Browse…" Margin="8,0,0,0"
                            Focusable="True" AutomationProperties.Name="Choose 7z.exe" />
                    <TextBox x:Name="SevenZipPath" Style="{StaticResource FieldBox}" Tag="Found automatically"
                             AutomationProperties.LabeledBy="{Binding ElementName=SevenZipLabel}" />
                </DockPanel>
                <TextBlock x:Name="SevenZipStatus" Style="{StaticResource Hint}" />

                <TextBlock Text="The others" Style="{StaticResource Label}" Margin="0,14,0,6" />
                <ItemsControl x:Name="OtherTools" Focusable="False" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4" AutomationProperties.Name="{Binding Spoken}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolMark" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolName" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,2,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE711;" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Found}" Value="True">
                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource ToolStatus}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Windows" Style="{StaticResource SectionHeading}" />
                <CheckBox x:Name="StartupCheck" Style="{StaticResource Check}" Content="Start with Windows" />
                <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,10" Text="Tanjelo waits in the notification area, ready for the shortcut." />
                <CheckBox x:Name="SendToCheck" Style="{StaticResource Check}" Content="Show in the &quot;Send to&quot; menu" />
                <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,0" Text="Right-click files, then Send to, then Tanjelo." />
                <TextBlock x:Name="WindowsProblem" Style="{StaticResource Problem}" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="18,10,14,14">
            <TextBlock x:Name="FileNote" FontSize="12" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,0,200,0" Text="Kept in settings.json, which you can also edit by hand" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OpenFileButton" Style="{StaticResource SubtleButton}" Content="Open settings file" Focusable="True" />
                <Button x:Name="DoneButton" Style="{StaticResource PrimaryButton}" Content="Done" Focusable="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
