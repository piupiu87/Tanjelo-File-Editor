<Window x:Class="Tanjelo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tanjelo"
        Title="{x:Static local:Strings.TanjeloSettings}" Width="600" Height="740" MinWidth="520" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,18,0,10" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        </Style>
        <Style x:Key="Problem" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style x:Key="ToolStatus" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Drag here to move the window -->
        <Grid Height="56" Margin="18,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="32" Height="32" Margin="0,0,12,0">
                <Ellipse Fill="{DynamicResource AccentSoft}" />
                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Static local:Strings.Settings2}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock x:Name="Subheading" FontSize="12" Margin="0,1,0,0" Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis" Text="{x:Static local:Strings.ChangesApplyAtOnce}" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Padding="10"
                    VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{x:Static local:Strings.CloseEsc}"
                    AutomationProperties.Name="{x:Static local:Strings.Close}" />
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,6,0">
            <StackPanel Margin="18,0,18,8" KeyboardNavigation.TabNavigation="Continue">

                <TextBlock Text="{x:Static local:Strings.Shortcuts}" Style="{StaticResource SectionHeading}" Margin="0,4,0,10" />
                <TextBlock x:Name="MenuShortcutLabel" Text="{x:Static local:Strings.OpenTheMenu}" Style="{StaticResource Label}" />
                <local:ShortcutBox x:Name="MenuShortcut" Style="{StaticResource FieldBox}" Width="220" HorizontalAlignment="Left"
                                   AutomationProperties.LabeledBy="{Binding ElementName=MenuShortcutLabel}"
                                   AutomationProperties.HelpText="{x:Static local:Strings.ClickHereAndPressTheKeysFor}" />
                <TextBlock x:Name="MenuShortcutHint" Style="{StaticResource Hint}"
                           Text="{x:Static local:Strings.WorksWhileFileExplorerTheDesktopOr}" />

                <TextBlock x:Name="ShelfShortcutLabel" Text="{x:Static local:Strings.ShowOrHideTheShelf}" Style="{StaticResource Label}" Margin="0,14,0,6" />
                <StackPanel Orientation="Horizontal">
                    <local:ShortcutBox x:Name="ShelfShortcut" Style="{StaticResource FieldBox}" Width="220" Optional="True" Tag="{x:Static local:Strings.None}"
                                       AutomationProperties.LabeledBy="{Binding ElementName=ShelfShortcutLabel}"
                                       AutomationProperties.HelpText="{x:Static local:Strings.ClickHereAndPressTheKeysFor2}" />
                    <Button x:Name="ClearShelfShortcut" Style="{StaticResource SubtleButton}" Content="{x:Static local:Strings.Remove}" Margin="8,0,0,0"
                            AutomationProperties.Name="{x:Static local:Strings.RemoveTheShelfShortcut}" />
                </StackPanel>
                <TextBlock x:Name="ShelfShortcutHint" Style="{StaticResource Hint}" Text="{x:Static local:Strings.WorksEverywhereOffUnlessYouSetOne}" />
                <TextBlock x:Name="ShortcutProblem" Style="{StaticResource Problem}" Visibility="Collapsed" />

                <TextBlock Text="{x:Static local:Strings.Appearance}" Style="{StaticResource SectionHeading}" />
                <TextBlock x:Name="ThemeLabel" Text="{x:Static local:Strings.Theme}" Style="{StaticResource Label}" />
                <WrapPanel x:Name="ThemeChoices" AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}">
                    <RadioButton x:Name="ThemeSystem" Style="{StaticResource Chip}" GroupName="Theme" Content="{x:Static local:Strings.SameAsWindows}" />
                    <RadioButton x:Name="ThemeLight" Style="{StaticResource Chip}" GroupName="Theme" Content="{x:Static local:Strings.Light}" />
                    <RadioButton x:Name="ThemeDark" Style="{StaticResource Chip}" GroupName="Theme" Content="{x:Static local:Strings.Dark}" />
                </WrapPanel>

                <TextBlock Text="{x:Static local:Strings.Quality}" Style="{StaticResource SectionHeading}" />
                <TextBlock x:Name="JpegLabel" Text="{x:Static local:Strings.JPGQuality}" Style="{StaticResource Label}" />
                <DockPanel>
                    <TextBlock x:Name="JpegValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}" />
                    <Slider x:Name="JpegSlider" Style="{StaticResource ThinSlider}" Minimum="1" Maximum="100" SmallChange="1" LargeChange="10"
                            IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.LabeledBy="{Binding ElementName=JpegLabel}" />
                </DockPanel>
                <TextBlock x:Name="WebpLabel" Text="{x:Static local:Strings.WebPQuality}" Style="{StaticResource Label}" Margin="0,12,0,6" />
                <DockPanel>
                    <TextBlock x:Name="WebpValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}" />
                    <Slider x:Name="WebpSlider" Style="{StaticResource ThinSlider}" Minimum="1" Maximum="100" SmallChange="1" LargeChange="10"
                            IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.LabeledBy="{Binding ElementName=WebpLabel}" />
                </DockPanel>
                <TextBlock x:Name="HeicLabel" Text="{x:Static local:Strings.HEICQuality}" Style="{StaticResource Label}" Margin="0,12,0,6" />
                <DockPanel>
                    <TextBlock x:Name="HeicValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}" />
                    <Slider x:Name="HeicSlider" Style="{StaticResource ThinSlider}" Minimum="1" Maximum="100" SmallChange="1" LargeChange="10"
                            IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.LabeledBy="{Binding ElementName=HeicLabel}" />
                </DockPanel>
                <TextBlock x:Name="DpiLabel" Text="{x:Static local:Strings.PDFPagesAsPictures}" Style="{StaticResource Label}" Margin="0,12,0,6" />
                <DockPanel>
                    <TextBlock x:Name="DpiValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}" />
                    <Slider x:Name="DpiSlider" Style="{StaticResource ThinSlider}" Minimum="72" Maximum="600" SmallChange="1" LargeChange="50"
                            IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.LabeledBy="{Binding ElementName=DpiLabel}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="{x:Static local:Strings.HigherNumbersLookBetterAndMakeBigger}" />

                <TextBlock Text="{x:Static local:Strings.OptionalPrograms}" Style="{StaticResource SectionHeading}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,-4,0,10"
                           Text="{x:Static local:Strings.InstalledSeparatelyAndFoundAutomaticallyFormatsThat}" />
                <TextBlock x:Name="FfmpegLabel" Text="{x:Static local:Strings.FfmpegForAudioAndVideo}" Style="{StaticResource Label}" />
                <!-- The box before its button, so Tab reaches them in reading order -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FfmpegPath" Style="{StaticResource FieldBox}" Tag="{x:Static local:Strings.FoundAutomatically}"
                             AutomationProperties.LabeledBy="{Binding ElementName=FfmpegLabel}" />
                    <Button x:Name="FfmpegBrowse" Grid.Column="1" Style="{StaticResource SubtleButton}" Content="{x:Static local:Strings.Browse}" Margin="8,0,0,0"
                            AutomationProperties.Name="{x:Static local:Strings.ChooseFfmpegExe}" />
                </Grid>
                <TextBlock x:Name="FfmpegStatus" Style="{StaticResource Hint}" />

                <TextBlock x:Name="SevenZipLabel" Text="{x:Static local:Strings.N7ZipFor7ZAndRARArchives}" Style="{StaticResource Label}" Margin="0,14,0,6" />
                <!-- The box before its button, so Tab reaches them in reading order -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SevenZipPath" Style="{StaticResource FieldBox}" Tag="{x:Static local:Strings.FoundAutomatically}"
                             AutomationProperties.LabeledBy="{Binding ElementName=SevenZipLabel}" />
                    <Button x:Name="SevenZipBrowse" Grid.Column="1" Style="{StaticResource SubtleButton}" Content="{x:Static local:Strings.Browse}" Margin="8,0,0,0"
                            AutomationProperties.Name="{x:Static local:Strings.Choose7zExe}" />
                </Grid>
                <TextBlock x:Name="SevenZipStatus" Style="{StaticResource Hint}" />

                <TextBlock Text="{x:Static local:Strings.TheOthers}" Style="{StaticResource Label}" Margin="0,14,0,6" />
                <ItemsControl x:Name="OtherTools" Focusable="False" Grid.IsSharedSizeScope="True" AutomationProperties.Name="{x:Static local:Strings.OtherOptionalPrograms}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4" AutomationProperties.Name="{Binding Spoken}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolMark" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolName" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,2,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE711;" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Found}" Value="True">
                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource ToolStatus}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{x:Static local:Strings.Windows}" Style="{StaticResource SectionHeading}" />
                <CheckBox x:Name="StartupCheck" Style="{StaticResource Check}" Content="{x:Static local:Strings.StartWithWindows}" />
                <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,10" Text="{x:Static local:Strings.TanjeloWaitsInTheNotificationAreaReady}" />
                <CheckBox x:Name="SendToCheck" Style="{StaticResource Check}" Content="{x:Static local:Strings.ShowInTheSendToMenu}" />
                <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,0" Text="{x:Static local:Strings.RightClickFilesThenSendToThen}" />
                <!-- Only on Windows 11, from a signed release, which brings the entry's package -->
                <StackPanel x:Name="Windows11MenuRow" Margin="0,10,0,0">
                    <CheckBox x:Name="Windows11MenuCheck" Style="{StaticResource Check}" Content="{x:Static local:Strings.ShowInTheWindows11Menu}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,0" Text="{x:Static local:Strings.Windows11MenuHint}" />
                </StackPanel>
                <TextBlock x:Name="WindowsProblem" Style="{StaticResource Problem}" Visibility="Collapsed" />

                <TextBlock Text="{x:Static local:Strings.Updates}" Style="{StaticResource SectionHeading}" />
                <CheckBox x:Name="CheckUpdatesBox" Style="{StaticResource Check}" Content="{x:Static local:Strings.CheckForANewVersionOnceA}" />
                <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,0"
                           Text="{x:Static local:Strings.AsksGitHubForTheNumberOfThe}" />
                <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" Margin="27,6,0,0" Foreground="{DynamicResource TextSecondary}"
                           Visibility="Collapsed">
                    <Hyperlink x:Name="UpdateLink" Foreground="{DynamicResource Accent}"><Run Text="{x:Static local:Strings.SeeWhatSNew}" /></Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="18,10,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FileNote" FontSize="12" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Text="{x:Static local:Strings.KeptInSettingsJsonWhichYouCan}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                <Button x:Name="OpenFileButton" Style="{StaticResource SubtleButton}" Content="{x:Static local:Strings.OpenSettingsFile}" />
                <Button x:Name="DoneButton" Style="{StaticResource PrimaryButton}" Content="{x:Static local:Strings.Done}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
