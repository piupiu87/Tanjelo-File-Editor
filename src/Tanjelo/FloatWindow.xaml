<Window x:Class="Tanjelo.FloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tanjelo"
        Title="{x:Static local:Strings.TanjeloFloat}" Width="248" SizeToContent="Height"
        Style="{StaticResource PopupWindow}" ShowActivated="False" AllowDrop="True">
    <Window.Resources>
        <Style x:Key="ItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="ToolTip" Value="{Binding Path}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Folder}" />
            <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Back" CornerRadius="5" Background="Transparent">
                                <ContentPresenter />
                            </Border>
                            <!-- Selected items are outlined in a contrast theme; laid over so the item keeps its size -->
                            <Border x:Name="Outline" CornerRadius="5" BorderThickness="1.5" BorderBrush="Transparent" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource Selected}" />
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource SelectedBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8,8,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title, how many, and the shelf's own buttons -->
        <Grid Margin="6,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE718;" FontSize="13" Margin="0,1,8,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource Accent}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center">
                <Run Text="{x:Static local:Strings.Float}" FontWeight="SemiBold" FontSize="13.5" />
                <Run x:Name="CountText" FontSize="11.5" Foreground="{DynamicResource TextTertiary}" />
            </TextBlock>
            <Button x:Name="ClearButton" Grid.Column="2" Style="{StaticResource SubtleButton}" Content="{x:Static local:Strings.Clear}" Padding="9,3"
                    ToolTip="{x:Static local:Strings.TakeEverythingOffTheShelfTheFiles}" />
            <Button x:Name="HideButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="4,0,0,0"
                    ToolTip="{x:Static local:Strings.HideTheShelfShowShelfInThe}" />
        </Grid>

        <!-- The parked files, dragged out from here -->
        <ListBox x:Name="List" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0" SelectionMode="Extended" AutomationProperties.Name="{x:Static local:Strings.FilesOnTheShelf}"
                 ItemContainerStyle="{StaticResource ItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="46" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Thumbnail}" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Folder}" FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9" Margin="2,0,2,0"
                                VerticalAlignment="Center" ToolTip="{x:Static local:Strings.TakeOffTheShelf}" Click="OnRemove"
                                AutomationProperties.Name="{Binding Name, StringFormat=Take {0} off the shelf}" IsTabStop="False" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <!-- Right-clicking a selected file keeps the selection, so these act on all the selected files -->
            <ListBox.ContextMenu>
                <ContextMenu x:Name="ItemMenu" FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource TextPrimary}"
                             Grid.IsSharedSizeScope="True">
                    <ContextMenu.Template>
                        <ControlTemplate TargetType="ContextMenu">
                            <!-- The shadow on a frame of its own, so the text keeps its ClearType -->
                            <Grid Margin="0,0,10,10" MinWidth="200">
                                <Border CornerRadius="7" Background="{DynamicResource Surface}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.22" />
                                    </Border.Effect>
                                </Border>
                                <Border CornerRadius="7" Padding="4" Background="{DynamicResource Surface}" BorderThickness="1"
                                        BorderBrush="{DynamicResource FieldBorder}">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </ContextMenu.Template>
                    <ContextMenu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Grid>
                                            <Border x:Name="Back" CornerRadius="4" Background="Transparent" Padding="8,6,12,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Keys" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}"
                                                               FontSize="14" VerticalAlignment="Center" />
                                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="28,0,0,0" FontSize="12"
                                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <!-- In a contrast theme the item the pointer or the arrows are on is outlined -->
                                            <Border x:Name="Outline" CornerRadius="4" BorderThickness="1.5" BorderBrush="Transparent" IsHitTestVisible="False" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource Hover}" />
                                                <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource SelectedBorder}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Separator">
                                        <Border Height="1" Margin="8,4" Background="{DynamicResource FieldBorder}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ContextMenu.Resources>
                    <MenuItem x:Name="OpenItem" Header="{x:Static local:Strings.Open}" Icon="&#xE8E5;" InputGestureText="{x:Static local:Strings.Enter}"
                              FontWeight="SemiBold" Click="OnOpen" />
                    <MenuItem x:Name="ShowInFolderItem" Header="{x:Static local:Strings.ShowInFolder}" Icon="&#xE838;" Click="OnShowInFolder" />
                    <MenuItem x:Name="CopyItem" Header="{x:Static local:Strings.Copy}" Icon="&#xE8C8;" InputGestureText="{x:Static local:Strings.CtrlC}"
                              Click="OnCopy" />
                    <!-- Save as… for one file, Save to… a folder for several -->
                    <MenuItem x:Name="SaveAsItem" Header="{x:Static local:Strings.SaveAs}" Icon="&#xE792;" Click="OnSave" />
                    <MenuItem x:Name="SaveToItem" Header="{x:Static local:Strings.SaveTo}" Icon="&#xE792;" Click="OnSave" />
                    <Separator />
                    <MenuItem x:Name="TakeOffItem" Header="{x:Static local:Strings.TakeOffTheShelf}" Icon="&#xE711;"
                              InputGestureText="{x:Static local:Strings.Delete}" Click="OnTakeOff" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <!-- Empty: where to drop. Otherwise: drag everything at once, and the keys -->
        <Border x:Name="DropZone" Grid.Row="1" Margin="2,2,2,2" Padding="12,22" CornerRadius="6" BorderThickness="1.5"
                BorderBrush="{DynamicResource FieldBorder}" Background="{DynamicResource Field}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="22" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Accent}" />
                <TextBlock Text="{x:Static local:Strings.DropFilesHereToParkThem}" FontWeight="SemiBold" FontSize="12.5" Margin="0,8,0,2"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static local:Strings.DragThemOutToAFolderAn}" FontSize="11.5"
                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static local:Strings.OrPressCtrlVToPasteAPicture}" FontSize="11.5" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid x:Name="Footer" Grid.Row="2" Margin="6,6,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="KeysText" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}"
                       TextWrapping="Wrap" />
            <Border x:Name="DragAll" Grid.Column="1" CornerRadius="4" Padding="8,3" Margin="6,0,0,0" Cursor="SizeAll" VerticalAlignment="Center"
                    Background="{DynamicResource Subtle}" ToolTip="{x:Static local:Strings.DragEverythingOnTheShelfAtOnce}">
                <TextBlock FontSize="11.5">
                    <Run FontFamily="{StaticResource IconFont}" Text="&#xE7C2;" /><Run Text="{x:Static local:Strings.All}" />
                </TextBlock>
            </Border>
        </Grid>

        <!-- What just happened, such as a paste with nothing to paste or a copy saved; it goes after a few seconds -->
        <TextBlock x:Name="Notice" Grid.Row="3" Margin="6,6,2,0" FontSize="11.5" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{DynamicResource TextSecondary}" />
    </Grid>
</Window>
