<Window x:Class="Tanjelo.FormatMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tanjelo" Width="330" SizeToContent="Height"
        Style="{StaticResource PopupWindow}" Opacity="0">
    <Window.Resources>
        <CollectionViewSource x:Key="Entries">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="EntryStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <!-- ListBoxItem defaults to the system text colour, which is black even in dark mode. -->
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <EventSetter Event="MouseEnter" Handler="OnEntryHover" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Back" CornerRadius="5" Background="Transparent" />
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource Accent}" Visibility="Hidden" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource Selected}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="6,6,6,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- What was selected -->
        <Grid Margin="8,6,8,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" Margin="0,0,11,0" CornerRadius="6" Background="{DynamicResource AccentSoft}">
                <Grid>
                    <TextBlock x:Name="FallbackGlyph" FontFamily="{StaticResource IconFont}" FontSize="17" Text="&#xE8A5;"
                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image x:Name="Thumbnail" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Subheading" FontSize="12" Margin="0,1,0,0" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- Filter box: typing anywhere goes here -->
        <Border Grid.Row="1" Margin="2,0,2,6" CornerRadius="5" BorderThickness="1"
                Background="{DynamicResource Field}" BorderBrush="{DynamicResource FieldBorder}">
            <Grid>
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}" />
                <TextBox x:Name="Search" Padding="29,6,8,6" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                         FontFamily="{StaticResource UiFont}" FontSize="13" />
                <TextBlock x:Name="Placeholder" Text="Convert to…" Margin="31,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" Foreground="{DynamicResource TextTertiary}" />
            </Grid>
        </Border>

        <!-- Formats, grouped by what they produce -->
        <ListBox x:Name="List" Grid.Row="2" MaxHeight="520" BorderThickness="0" Background="Transparent" Padding="0"
                 ItemsSource="{Binding Source={StaticResource Entries}}" ItemContainerStyle="{StaticResource EntryStyle}"
                 Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                 PreviewMouseLeftButtonUp="OnListClick">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <!-- Descriptions line up within each section; a long label elsewhere doesn't push them all right. -->
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Grid.IsSharedSizeScope" Value="True" />
                        </Style>
                    </GroupStyle.ContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="10,8,0,3" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiary}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="32" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state and notes about missing tools -->
        <StackPanel Grid.Row="3" Margin="10,2,10,4">
            <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="0,4,0,6" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
            <ItemsControl x:Name="HintList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" FontSize="12" Margin="0,2,7,0"
                                       Foreground="{DynamicResource TextTertiary}" />
                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Window>
