<Window x:Class="Tanjelo.Editors.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tanjelo" Width="1100" Height="760" MinWidth="720" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}" Opacity="0">
    <!-- A frame of our own, as on the other windows, that still resizes, snaps and maximizes. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The editor and the file. Drag here to move the window; double-click to maximize. -->
        <Grid Height="56" Margin="18,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="32" Height="32" Margin="0,0,12,0">
                <Ellipse Fill="{DynamicResource AccentSoft}" />
                <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Subheading" FontSize="12" Margin="0,1,0,0" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="MaximizeButton" Style="{StaticResource IconButton}" Content="&#xE922;" Padding="10"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize" />
                <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE711;" Padding="10"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Cancel (Esc)" />
            </StackPanel>
        </Grid>

        <!-- The editor's tools on the left, undo and redo on the right -->
        <DockPanel Grid.Row="1" Margin="14,0,14,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" FontSize="13" Padding="8" ToolTip="Undo (Ctrl+Z)" />
                <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;" FontSize="13" Padding="8" ToolTip="Redo (Ctrl+Y)" />
            </StackPanel>
            <ContentPresenter x:Name="ToolSlot" VerticalAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="2" Margin="14,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Stage" CornerRadius="6" Background="{DynamicResource Subtle}" ClipToBounds="True">
                <Grid>
                    <ContentPresenter x:Name="MainSlot" />
                    <TextBlock x:Name="Message" Margin="32" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False" />
                    <ProgressBar x:Name="Busy" Style="{StaticResource ThinProgress}" IsIndeterminate="True" Width="160" Height="3"
                                 VerticalAlignment="Center" Margin="0,48,0,0" Visibility="Collapsed" IsHitTestVisible="False" />
                    <!-- What won't survive saving, said before it's saved -->
                    <Border x:Name="NoticeBar" VerticalAlignment="Top" Margin="10" Padding="12,8" CornerRadius="5"
                            Background="{DynamicResource AccentSoft}" Visibility="Collapsed" IsHitTestVisible="False">
                        <DockPanel>
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,10,0"
                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Top" />
                            <TextBlock x:Name="NoticeText" FontSize="12.5" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
            <ScrollViewer x:Name="PanelScroller" Grid.Column="1" Width="292" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto"
                          Focusable="False" Visibility="Collapsed">
                <ContentPresenter x:Name="PanelSlot" Margin="0,0,6,0" />
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="3" Margin="14,10,14,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel x:Name="ZoomBar" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,14,0">
                    <Button x:Name="ZoomOutButton" Style="{StaticResource IconButton}" Content="&#xE71F;" FontSize="12" ToolTip="Zoom out (Ctrl+−)" />
                    <TextBlock x:Name="ZoomText" Width="46" TextAlignment="Center" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}" />
                    <Button x:Name="ZoomInButton" Style="{StaticResource IconButton}" Content="&#xE8A3;" FontSize="12" ToolTip="Zoom in (Ctrl++)" />
                    <Button x:Name="FitButton" Style="{StaticResource SubtleButton}" Content="Fit" Padding="10,4" ToolTip="Fit the picture (Ctrl+0)" />
                    <Button x:Name="ActualButton" Style="{StaticResource SubtleButton}" Content="100%" Padding="10,4" ToolTip="Show every pixel (Ctrl+1)" />
                </StackPanel>
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="Note" FontSize="12" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Text="Saved as a copy beside the original" />
                <Button x:Name="CancelButton" Style="{StaticResource SubtleButton}" Content="Cancel" />
                <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save" ToolTip="Save a copy (Ctrl+S)" />
            </StackPanel>
        </Grid>

        <!-- Asked on Cancel when something changed -->
        <Grid x:Name="Confirm" Grid.RowSpan="4" Background="#66000000" Visibility="Collapsed">
            <Border Width="360" Padding="20,18,16,16" CornerRadius="8" Background="{DynamicResource Surface}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Discard your changes?" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="Nothing has been saved. The original stays as it is either way." Margin="0,6,0,18" FontSize="12.5"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="KeepButton" Style="{StaticResource SubtleButton}" Content="Keep editing" />
                        <Button x:Name="DiscardButton" Style="{StaticResource PrimaryButton}" Content="Discard" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
