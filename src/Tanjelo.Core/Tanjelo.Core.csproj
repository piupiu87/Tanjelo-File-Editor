<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <!-- For System.Windows.Automation, used to confirm Word's PDF import prompt. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF drops System.IO from the implicit usings (it clashes with System.Windows.Shapes.Path). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tanjelo.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.0.0" GeneratePathProperty="true" />
    <!-- Pre-1.0, so pinned exactly. Reads the text of PDFs, in reading order. -->
    <PackageReference Include="PdfPig" Version="[0.1.16]" />
    <!-- Writes PowerPoint files directly, so PDF to PPTX works without Office. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Markdig" Version="1.5.0" />
    <!-- Only the SDK; the runtime that prints HTML to PDF is part of Windows. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <!-- 6.2.x is the last MIT release. PDFsharp 6.5.0 and later are AGPL-3.0 (or commercial), which Tanjelo can't ship. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- YuNet (MIT, from OpenCV Zoo), the face finder Windows' own machine learning runs; licence in licenses\YuNet-LICENSE.txt. -->
    <EmbeddedResource Include="Models\face_detection_yunet_2026may.onnx" LogicalName="yunet.onnx" />
  </ItemGroup>

  <ItemGroup>
    <!-- ImageMagick's native DLL bundles many libraries whose licenses require shipping their notices with it. -->
    <None Include="$(PkgMagick_NET-Q8-x64)\Notice.txt" Link="licenses\ImageMagick-NOTICE.txt" Visible="false"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Licences and notices that must travel with the binaries, for packages that don't ship them (PdfPig, Markdig, WebView2). -->
    <None Include="..\..\licenses\*.txt" Link="licenses\%(Filename)%(Extension)" Visible="false"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
