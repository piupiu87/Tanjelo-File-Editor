<Window x:Class="Tanjelo.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tanjelo.Setup"
        Width="620" Height="520" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <!-- Setup's pages, or the uninstaller's, one at a time: each page is a panel below, shown by Show(). -->
    <Grid x:Name="Root" Background="{DynamicResource Surface}" TextElement.FontFamily="{DynamicResource UiFont}" TextElement.FontSize="13"
          TextElement.Foreground="{DynamicResource TextPrimary}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Tanjelo.Setup;component/Styles.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="32,28,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Image x:Name="HeaderIcon" Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="Heading" Style="{StaticResource Heading}" />
                <TextBlock x:Name="Subheading" Style="{StaticResource Note}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="92,20,32,12">
            <!-- Welcome: what Tanjelo is, what's installed already, the licence. -->
            <StackPanel x:Name="WelcomePage">
                <TextBlock Style="{StaticResource Body}" Text="{x:Static local:Strings.TanjeloConvertsAndEditsFiles}" />
                <TextBlock x:Name="InstalledText" Style="{StaticResource Body}" Visibility="Collapsed" />
                <TextBlock Style="{StaticResource Body}">
                    <Run Text="{x:Static local:Strings.TanjeloIsFreeAndOpenSource}" />
                    <Hyperlink x:Name="LicenceLink" Click="OpenLicence"><Run Text="{x:Static local:Strings.MITLicence}" /></Hyperlink><Run Text="." />
                </TextBlock>
            </StackPanel>

            <!-- Location: for whom, and the folder. -->
            <StackPanel x:Name="LocationPage" Visibility="Collapsed">
                <TextBlock x:Name="ScopeLabel" Style="{StaticResource Label}" Text="{x:Static local:Strings.InstallTanjeloFor}" />
                <RadioButton x:Name="ForMe" Style="{StaticResource Choice}" GroupName="Scope" Checked="ScopeChanged"
                             AutomationProperties.Name="{x:Static local:Strings.JustForMe}" AutomationProperties.HelpText="{x:Static local:Strings.NoAdministratorPermissionNeeded}">
                    <StackPanel>
                        <TextBlock Text="{x:Static local:Strings.JustForMe}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,1,0,0" Text="{x:Static local:Strings.NoAdministratorPermissionNeeded}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ForEveryone" Style="{StaticResource Choice}" GroupName="Scope" Checked="ScopeChanged"
                             AutomationProperties.Name="{x:Static local:Strings.EveryoneOnThisPC}" AutomationProperties.HelpText="{x:Static local:Strings.AsksForAdministratorPermissionOnce}">
                    <StackPanel>
                        <TextBlock Text="{x:Static local:Strings.EveryoneOnThisPC}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,1,0,0" Text="{x:Static local:Strings.AsksForAdministratorPermissionOnce}" />
                    </StackPanel>
                </RadioButton>
                <TextBlock x:Name="FolderLabel" Style="{StaticResource Label}" Margin="0,8,0,6" Text="{x:Static local:Strings.Folder}" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Style="{StaticResource FieldBox}" TextChanged="FolderChanged"
                             AutomationProperties.LabeledBy="{Binding ElementName=FolderLabel}" />
                    <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource SubtleButton}" Content="{x:Static local:Strings.Browse}" Click="Browse" />
                </Grid>
                <TextBlock x:Name="FolderNote" Style="{StaticResource Note}" />
                <TextBlock x:Name="SpaceText" Style="{StaticResource Note}" />
                <TextBlock x:Name="FolderProblem" Style="{StaticResource Problem}" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>

            <!-- Installing (or uninstalling): one bar for it all, the step in words, and the steps ticking off. -->
            <StackPanel x:Name="ProgressPage" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" Style="{StaticResource Body}" AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" Margin="0,0,0,18" AutomationProperties.Name="{x:Static local:Strings.Progress}" />
                <ItemsControl x:Name="StepList" Focusable="False" AutomationProperties.Name="{x:Static local:Strings.Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:StepRow}">
                            <Grid Margin="0,0,0,8" AutomationProperties.Name="{Binding Spoken}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="13" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextTertiary}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="Label" Text="{Binding Label}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding Detail}" Style="{DynamicResource Note}" Margin="0,1,0,0" Visibility="{Binding DetailVisibility}" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Working">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Done">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Success}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Danger}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Done: how it went, and Tanjelo to start. -->
            <StackPanel x:Name="DonePage" Visibility="Collapsed">
                <TextBlock x:Name="DoneText" Style="{StaticResource Body}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="ProblemText" Style="{StaticResource Problem}" Visibility="Collapsed" />
                <TextBlock x:Name="LogLine" Style="{StaticResource Note}" Visibility="Collapsed">
                    <Hyperlink x:Name="LogLink" Click="OpenLog"><Run Text="{x:Static local:Strings.OpenSetupSLog}" /></Hyperlink>
                </TextBlock>
                <CheckBox x:Name="StartCheck" Style="{StaticResource Check}" Margin="0,8,0,0" IsChecked="True" Content="{x:Static local:Strings.StartTanjelo}" />
            </StackPanel>

            <!-- The uninstaller's first page: what goes and what stays. -->
            <StackPanel x:Name="ConfirmPage" Visibility="Collapsed">
                <TextBlock x:Name="ConfirmText" Style="{StaticResource Body}" />
                <TextBlock Style="{StaticResource Body}" Text="{x:Static local:Strings.YourSettingsStayInAppData}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource Footer}" Padding="32,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Style="{StaticResource SubtleButton}" Content="{x:Static local:Strings.Back}" Click="Back" />
                <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Next" />
                <Button x:Name="CancelButton" Style="{StaticResource SubtleButton}" IsCancel="True" Content="{x:Static local:Strings.Cancel}" Click="CancelClicked" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
