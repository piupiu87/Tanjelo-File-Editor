<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <!-- WPF matches Tanjelo.Core; WinForms brings System.Drawing, which draws the image fixtures. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Include="System.IO" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Files the tests can't make, such as a photo of a face; Fixtures\README.md says where each comes from. -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tanjelo.Core\Tanjelo.Core.csproj" />
    <!-- For the app's pure helpers, such as where the menu is placed. -->
    <ProjectReference Include="..\..\src\Tanjelo\Tanjelo.csproj" />
    <!-- The Windows 11 menu entry's handing over of a selection; it's published natively, but builds as a library too. -->
    <ProjectReference Include="..\..\src\Tanjelo.ShellMenu\Tanjelo.ShellMenu.csproj" />
  </ItemGroup>

</Project>
